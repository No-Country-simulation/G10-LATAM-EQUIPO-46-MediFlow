# Copia este archivo como .env y completa los valores.
# El .env NUNCA se sube al repositorio.

# --- Modelo de lenguaje ---------------------------------------------------
GEMINI_API_KEY=
# Si queda vacio se usa el que trae el proyecto por defecto.
# Para ver cuales admite tu clave: python scripts/listar_modelos.py
GEMINI_MODEL=

# --- Donde se guardan los documentos --------------------------------------
# "local" guarda en disco: alcanza para desarrollar y para la demo sin red.
# "oci"   usa OCI Object Storage con credenciales IAM propias.
# "par"   usa OCI con un Pre-Authenticated Request: no necesita usuario ni
#         clave, solo el enlace. Es lo mas rapido para que todo el equipo
#         escriba en el mismo bucket.
MEDIFLOW_ALMACEN=local
MEDIFLOW_ALMACEN_LOCAL=.almacen
MEDIFLOW_BUCKET=

# --- Pre-Authenticated Request (solo si MEDIFLOW_ALMACEN=par) -------------
# La URL COMPLETA es la credencial: quien la tenga puede leer y escribir en el
# bucket. No la pegues en Discord ni la subas al repositorio. Caduca en la
# fecha que se eligio al crearla.
# Se crea en la consola: Bucket -> Pre-Authenticated Requests -> Create.
MEDIFLOW_OCI_PAR=

# --- Credenciales de OCI (solo si MEDIFLOW_ALMACEN=oci) -------------------
# Se obtienen en la consola de OCI: perfil -> My profile -> API keys ->
# Add API key. Al generarla, OCI muestra un bloque de configuracion con estos
# valores y descarga un archivo .pem con la clave privada.
#
# Alternativa mas comoda: en lugar de completar esto, guarda el archivo
# ~/.oci/config que la propia consola te ofrece. Si estas variables quedan
# vacias, se usa ese archivo.

OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_REGION=sa-saopaulo-1

# La clave privada: o el contenido completo del PEM (con los saltos de linea
# escapados como \n), o la ruta al archivo .pem.
# NUNCA subas el .pem al repositorio.
OCI_PRIVATE_KEY=

# Opcional: solo si protegiste la clave con una frase de paso.
OCI_PASSPHRASE=

# Opcional: identifica la tenancy. Si queda vacio, se consulta al arrancar.
OCI_NAMESPACE=

# --- Umbrales del agente --------------------------------------------------
# Las reglas de triaje (umbral de confianza, canales prioritarios y destinos)
# se configuran en `config/triaje.toml` y desde la pantalla de configuracion.
#
# MEDIFLOW_UMBRAL_CONFIANZA existe y TIENE PRECEDENCIA sobre el archivo, pero
# dejarla puesta hace que la pantalla mienta: guardaria el valor nuevo en el
# archivo y el agente seguiria usando el de aqui. Se usa solo para forzar un
# umbral desde fuera en un despliegue concreto, y en ese caso la pantalla lo
# avisa y marca el campo como bloqueado.
# MEDIFLOW_UMBRAL_CONFIANZA=

# --- Pantalla de configuracion (opcional) ---------------------------------
# Sin esta clave, el panel de reglas queda en SOLO LECTURA. Con ella, quien la
# tenga puede cambiar el umbral, los canales y los destinos desde la web.
#
# La pagina esta abierta a internet sin contraseña: sin clave, cualquiera con
# el enlace podria poner el umbral en cero y desactivar la revision humana.
# Usa una cadena larga y al azar, y no la subas al repositorio.
MEDIFLOW_ADMIN_CLAVE=

# --- Alertas en tiempo real (opcional) ------------------------------------
# Entrega real de la alerta de guardia que el agente genera ante un hallazgo
# critico. Sin nada de esto configurado, la alerta igual viaja en el JSON de
# la respuesta: lo unico que cambia es que no se envia a ningun lado.
#
# Un canal caido NUNCA invalida un triaje: el documento ya quedo clasificado,
# enrutado y guardado antes de que se intente notificar.

# Webhook entrante. Sirve Slack, Discord (agregando /slack al final de la
# URL), Teams o un nodo Webhook de n8n.
# OJO: la URL es una credencial. Quien la tenga puede publicar en ese canal.
MEDIFLOW_ALERTA_WEBHOOK=

# Correo. Hacen falta las dos primeras; usuario y clave solo si el servidor
# pide autenticacion.
MEDIFLOW_SMTP_HOST=
MEDIFLOW_ALERTA_EMAIL=
MEDIFLOW_SMTP_PUERTO=587
MEDIFLOW_SMTP_USUARIO=
MEDIFLOW_SMTP_CLAVE=

# Segundos antes de abandonar el envio. Un webhook lento bloquea el unico
# worker del contenedor y deja la pagina colgada para todos.
MEDIFLOW_ALERTA_TIMEOUT=5
