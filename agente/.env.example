# Copia este archivo como .env y completa los valores.
# El .env NUNCA se sube al repositorio.

# --- Modelo de lenguaje ---------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Donde se guardan los documentos --------------------------------------
# "local" guarda en disco: alcanza para desarrollar y para la demo sin red.
# "oci"   usa OCI Object Storage con credenciales IAM propias.
# "par"   usa OCI con un Pre-Authenticated Request: no necesita usuario ni
#         clave, solo el enlace. Es lo mas rapido para que todo el equipo
#         escriba en el mismo bucket.
MEDIFLOW_ALMACEN=local
MEDIFLOW_ALMACEN_LOCAL=.almacen
MEDIFLOW_BUCKET=

# --- Pre-Authenticated Request (solo si MEDIFLOW_ALMACEN=par) -------------
# La URL COMPLETA es la credencial: quien la tenga puede leer y escribir en el
# bucket. No la pegues en Discord ni la subas al repositorio. Caduca en la
# fecha que se eligio al crearla.
# Se crea en la consola: Bucket -> Pre-Authenticated Requests -> Create.
MEDIFLOW_OCI_PAR=

# --- Credenciales de OCI (solo si MEDIFLOW_ALMACEN=oci) -------------------
# Se obtienen en la consola de OCI: perfil -> My profile -> API keys ->
# Add API key. Al generarla, OCI muestra un bloque de configuracion con estos
# valores y descarga un archivo .pem con la clave privada.
#
# Alternativa mas comoda: en lugar de completar esto, guarda el archivo
# ~/.oci/config que la propia consola te ofrece. Si estas variables quedan
# vacias, se usa ese archivo.

OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_REGION=sa-saopaulo-1

# La clave privada: o el contenido completo del PEM (con los saltos de linea
# escapados como \n), o la ruta al archivo .pem.
# NUNCA subas el .pem al repositorio.
OCI_PRIVATE_KEY=

# Opcional: solo si protegiste la clave con una frase de paso.
OCI_PASSPHRASE=

# Opcional: identifica la tenancy. Si queda vacio, se consulta al arrancar.
OCI_NAMESPACE=

# --- Umbrales del agente --------------------------------------------------
# Por debajo de esta confianza, el caso va a revision humana.
MEDIFLOW_UMBRAL_CONFIANZA=0.70
